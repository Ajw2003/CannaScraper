history.db
history.db-wal
history.db-shm
# Backup normalize_db.py takes before splitting the observations table.
# Same size as the database itself -- keep it out of the repo.
history.db.pre-normalize

# Benchmark output from db_bench.py --save.
bench_*.json

# Holds the admin password hash and, if you use a named tunnel, its token.
settings.json
ratelimit.json
# Appends a row per request on every probe run.
ratelimit_probe.csv

# Build output and the vendored tunnel binary.
dist/
build/
cloudflared.exe

# Written by build.ps1 on every build; records this machine's checkout path
# and the commit at build time, so it is regenerated output, not source.
buildinfo.json

# Python bytecode caches, regenerated on every run.
__pycache__/
